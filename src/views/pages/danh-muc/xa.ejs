<%- include('../../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Danh sách xã</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
        <i class="fas fa-plus"></i> Thêm mới
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle" id="xaTable">
                <thead>
                    <tr>
                        <th>Mã xã</th>
                        <th>Tên xã</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (data && data.length > 0) { %>
                        <% data.forEach(item => { %>
                            <tr>
                                <td><%= item.ma_xa %></td>
                                <td><%= item.ten_xa %></td>
                                <td>
                                    <span class="badge <%= item.trang_thai === 'dang_hoat_dong' ? 'bg-success' : 'bg-secondary' %>">
                                        <%= item.trang_thai === 'dang_hoat_dong' ? 'Hoạt động' : 'Ngừng hoạt động' %>
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal" data-id="<%= item.id %>" data-ma_xa="<%= item.ma_xa %>" data-ten_xa="<%= item.ten_xa %>" data-ten_xa_cu="<%= item.ten_xa_cu || '' %>" data-vnpt_khu_vuc_id="<%= item.vnpt_khu_vuc_id || '' %>" data-cap_hanh_chinh="<%= item.cap_hanh_chinh || 'xa' %>" data-ma_hanh_chinh="<%= item.ma_hanh_chinh || '' %>" data-ghi_chu="<%= item.ghi_chu || '' %>" data-trang_thai="<%= item.trang_thai %>">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-secondary" onclick="deactivateXa(<%= item.id %>)" title="Ngừng sử dụng">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteXa(<%= item.id %>)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="4" class="text-center text-muted">Không có dữ liệu</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<% if (pagination && pagination.totalPages > 1) { %>
    <%
        const currentPage = Number(pagination.page || 1);
        const totalPages = Number(pagination.totalPages || 1);
        const pageItems = [];

        if (totalPages <= 7) {
            for (let i = 1; i <= totalPages; i++) pageItems.push(i);
        } else {
            pageItems.push(1);
            if (currentPage > 3) pageItems.push('...');

            let start = Math.max(2, currentPage - 1);
            let end = Math.min(totalPages - 1, currentPage + 1);

            if (currentPage <= 3) {
                start = 2;
                end = 4;
            }

            if (currentPage >= totalPages - 2) {
                start = totalPages - 3;
                end = totalPages - 1;
            }

            for (let i = start; i <= end; i++) pageItems.push(i);
            if (currentPage < totalPages - 2) pageItems.push('...');
            pageItems.push(totalPages);
        }
    %>
    <nav class="mt-3">
        <ul class="pagination mb-0">
            <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=1">Đầu</a>
            </li>
            <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage - 1 %>">Trước</a>
            </li>

            <% pageItems.forEach((p) => { %>
                <% if (p === '...') { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } else { %>
                    <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= p %>"><%= p %></a>
                    </li>
                <% } %>
            <% }) %>

            <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage + 1 %>">Sau</a>
            </li>
            <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= totalPages %>">Cuối</a>
            </li>
        </ul>
    </nav>
<% } %>

<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm mới xã</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Ma xa</label>
                            <input class="form-control" name="ma_xa" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tên xã</label>
                            <input class="form-control" name="ten_xa" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tên xã cũ</label>
                            <input class="form-control" name="ten_xa_cu">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cấp hành chính</label>
                            <select class="form-select" name="cap_hanh_chinh">
                                <option value="xa">Xa</option>
                                <option value="phuong">Phuong</option>
                                <option value="thi_tran">Thi tran</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mã hành chính</label>
                            <input class="form-control" name="ma_hanh_chinh">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">VNPT khu vực</label>
                            <input class="form-control" name="vnpt_khu_vuc_id" type="number" min="1" placeholder="ID khu vực">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Ghi chú</label>
                            <textarea class="form-control" name="ghi_chu" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="mt-3 d-flex justify-content-end">
                        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa xã</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Ma xa</label>
                            <input class="form-control" name="ma_xa" id="editMaXa" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ten xa</label>
                            <input class="form-control" name="ten_xa" id="editTenXa" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ten xa cu</label>
                            <input class="form-control" name="ten_xa_cu" id="editTenXaCu">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cap hanh chinh</label>
                            <select class="form-select" name="cap_hanh_chinh" id="editCapHanhChinh">
                                <option value="xa">Xa</option>
                                <option value="phuong">Phuong</option>
                                <option value="thi_tran">Thi tran</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ma hanh chinh</label>
                            <input class="form-control" name="ma_hanh_chinh" id="editMaHanhChinh">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">VNPT khu vuc</label>
                            <input class="form-control" name="vnpt_khu_vuc_id" id="editVnptKhuVuc" type="number" min="1">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Trạng thái</label>
                            <select class="form-select" name="trang_thai" id="editTrangThai">
                                <option value="dang_hoat_dong">Hoạt động</option>
                                <option value="ngung_hoat_dong">Ngừng hoạt động</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Ghi chu</label>
                            <textarea class="form-control" name="ghi_chu" id="editGhiChu" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="mt-3 d-flex justify-content-end">
                        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Dong</button>
                        <button type="submit" class="btn btn-primary">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
const createForm = document.getElementById('createForm');
createForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(createForm).entries());
    Object.keys(payload).forEach((key) => {
        if (payload[key] === '') {
            delete payload[key];
        }
    });
    if (payload.vnpt_khu_vuc_id) payload.vnpt_khu_vuc_id = Number(payload.vnpt_khu_vuc_id);
    const res = await fetch('/api/danh-muc/xa', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });
    const result = await res.json();
    if (result.success) location.reload();
    else alert(result.message || 'Loi');
});

const editModal = document.getElementById('editModal');
editModal.addEventListener('show.bs.modal', function (event) {
    const button = event.relatedTarget;
    const id = button.getAttribute('data-id');
    document.getElementById('editMaXa').value = button.getAttribute('data-ma_xa');
    document.getElementById('editTenXa').value = button.getAttribute('data-ten_xa');
    document.getElementById('editTenXaCu').value = button.getAttribute('data-ten_xa_cu');
    document.getElementById('editCapHanhChinh').value = button.getAttribute('data-cap_hanh_chinh') || 'xa';
    document.getElementById('editMaHanhChinh').value = button.getAttribute('data-ma_hanh_chinh');
    document.getElementById('editVnptKhuVuc').value = button.getAttribute('data-vnpt_khu_vuc_id') || '';
    document.getElementById('editTrangThai').value = button.getAttribute('data-trang_thai');
    document.getElementById('editGhiChu').value = button.getAttribute('data-ghi_chu') || '';
    document.getElementById('editForm').dataset.id = id;
});

document.getElementById('editForm').addEventListener('submit', async function (e) {
    e.preventDefault();
    const id = this.dataset.id;
    const payload = Object.fromEntries(new FormData(this).entries());
    Object.keys(payload).forEach((key) => {
        if (payload[key] === '') {
            delete payload[key];
        }
    });
    if (payload.vnpt_khu_vuc_id) payload.vnpt_khu_vuc_id = Number(payload.vnpt_khu_vuc_id);
    const res = await fetch('/api/danh-muc/xa/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });
    const result = await res.json();
    if (result.success) location.reload();
    else alert(result.message || 'Loi');
});

async function deleteXa(id) {
    if (!confirm('Xoa VINH VIEN xa nay? Hanh dong khong the hoan tac.')) return;
    const res = await fetch('/api/danh-muc/xa/' + id, { method: 'DELETE' });
    const result = await res.json();
    if (result.success) location.reload();
    else alert(result.message || 'Loi');
}

async function deactivateXa(id) {
    if (!confirm('Ngung su dung xa nay?')) return;
    const res = await fetch('/api/danh-muc/xa/' + id + '/deactivate', { method: 'PATCH' });
    const result = await res.json();
    if (result.success) location.reload();
    else alert(result.message || 'Loi');
}
</script>
<%- include('../../partials/footer') %>