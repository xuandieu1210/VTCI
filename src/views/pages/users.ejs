<%- include('../partials/header') %>
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách người dùng</h5>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#userModal">+ Tạo tài khoản</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>VNPT khu vực</th>
                        <th>Phân quyền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (data && data.length > 0) { %>
                        <% data.forEach(user => { %>
                            <tr>
                                <td><%= user.username %></td>
                                <td><%= user.ho_ten %></td>
                                <td><%= user.email || '-' %></td>
                                <td>
                                    <span class="badge bg-primary"><%= user.vai_tro %></span>
                                </td>
                                <td><%= user.ten_khu_vuc || '-' %></td>
                                <td>
                                    <% const perms = Array.isArray(user.quyen_chuc_nang) ? user.quyen_chuc_nang : []; %>
                                    <% if (perms.length) { %>
                                        <small><%= perms.join(', ') %></small>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge <%= user.trang_thai === 'dang_hoat_dong' ? 'bg-success' : 'bg-secondary' %>">
                                        <%= user.trang_thai === 'dang_hoat_dong' ? 'Hoạt động' : 'Khóa' %>
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" onclick="editUser(<%= JSON.stringify(user) %>)">Sửa</button>
                                    <% if (user.trang_thai === 'dang_hoat_dong') { %>
                                        <button class="btn btn-sm btn-warning" onclick="lockUser(<%= user.id %>)">Khóa</button>
                                    <% } else { %>
                                        <button class="btn btn-sm btn-success" onclick="unlockUser(<%= user.id %>)">Mở khóa</button>
                                    <% } %>
                                    <button class="btn btn-sm btn-info" onclick="resetPassword(<%= user.id %>)">Reset</button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center text-muted">Không có dữ liệu</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<% if (pagination && pagination.totalPages > 1) { %>
    <%
        const currentPage = Number(pagination.page || 1);
        const totalPages = Number(pagination.totalPages || 1);
        const pageItems = [];

        if (totalPages <= 7) {
            for (let i = 1; i <= totalPages; i++) pageItems.push(i);
        } else {
            pageItems.push(1);
            if (currentPage > 3) pageItems.push('...');

            let start = Math.max(2, currentPage - 1);
            let end = Math.min(totalPages - 1, currentPage + 1);

            if (currentPage <= 3) {
                start = 2;
                end = 4;
            }

            if (currentPage >= totalPages - 2) {
                start = totalPages - 3;
                end = totalPages - 1;
            }

            for (let i = start; i <= end; i++) pageItems.push(i);
            if (currentPage < totalPages - 2) pageItems.push('...');
            pageItems.push(totalPages);
        }
    %>
    <nav class="mt-3">
        <ul class="pagination mb-0 justify-content-center">
            <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=1&limit=<%= pagination.limit || 20 %>">Đầu</a>
            </li>
            <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= pagination.limit || 20 %>">Trước</a>
            </li>

            <% pageItems.forEach((pageNum) => { %>
                <% if (pageNum === '...') { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } else { %>
                    <li class="page-item <%= pageNum === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= pageNum %>&limit=<%= pagination.limit || 20 %>"><%= pageNum %></a>
                    </li>
                <% } %>
            <% }) %>

            <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= pagination.limit || 20 %>">Sau</a>
            </li>
            <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= totalPages %>&limit=<%= pagination.limit || 20 %>">Cuối</a>
            </li>
        </ul>
    </nav>
<% } %>

<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userModalTitle">Tạo tài khoản</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="userForm">
                <div class="modal-body">
                    <input type="hidden" name="id" id="userId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Username</label>
                            <input class="form-control" name="username" id="username" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Họ tên</label>
                            <input class="form-control" name="ho_ten" id="ho_ten" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input class="form-control" type="email" name="email" id="email" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            <input class="form-control" name="so_dien_thoai" id="so_dien_thoai">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Vai trò</label>
                            <select class="form-select" name="vai_tro" id="vai_tro">
                                <option value="admin">Admin</option>
                                <option value="manager">Manager</option>
                                <option value="staff">Staff</option>
                                <option value="vnpt_khu_vuc">VNPT khu vực</option>
                            </select>
                        </div>
                        <div class="col-md-6" id="vnptAreaField" style="display:none;">
                            <label class="form-label">VNPT khu vực</label>
                            <select class="form-select" name="vnpt_khu_vuc_id" id="vnpt_khu_vuc_id"></select>
                        </div>
                        <div class="col-md-12" id="passwordField">
                            <label class="form-label">Mật khẩu</label>
                            <input class="form-control" type="password" name="password" id="password" placeholder="Để trống nếu không đổi">
                        </div>
                    </div>

                    <div class="mt-4">
                        <h6>Phân quyền chức năng</h6>
                        <div class="row g-2" id="permissionList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary" id="submitUserBtn">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const ALL_PERMISSIONS = [
    'dashboard',
    'ho_gia_dinh_xem',
    'ho_gia_dinh_sua',
    'ho_gia_dinh_them',
    'ho_so_xem',
    'ho_so_tai_len',
    'duyet_ho_so',
    'danh_muc_xem',
    'danh_muc_sua',
    'import_excel',
    'export_excel',
    'quan_ly_user'
];

const permissionLabels = {
    dashboard: 'Dashboard',
    ho_gia_dinh_xem: 'Xem hộ gia đình',
    ho_gia_dinh_sua: 'Sửa hộ gia đình',
    ho_gia_dinh_them: 'Thêm hộ gia đình',
    ho_so_xem: 'Xem hồ sơ',
    ho_so_tai_len: 'Tải lên hồ sơ',
    duyet_ho_so: 'Duyệt hồ sơ',
    danh_muc_xem: 'Xem danh mục',
    danh_muc_sua: 'Sửa danh mục',
    import_excel: 'Import Excel',
    export_excel: 'Export Excel',
    quan_ly_user: 'Quản lý người dùng'
};

function renderPermissions(selected = []) {
    const list = document.getElementById('permissionList');
    list.innerHTML = ALL_PERMISSIONS.map(code => `
        <div class="col-md-4">
            <label class="form-check">
                <input class="form-check-input" type="checkbox" value="${code}" ${selected.includes(code) ? 'checked' : ''}>
                <span class="form-check-label">${permissionLabels[code] || code}</span>
            </label>
        </div>
    `).join('');
}

async function loadVnptAreas() {
    try {
        const res = await fetch('/api/danh-muc/vnpt-khu-vuc?page=1&limit=1000');
        const result = await res.json();
        const items = Array.isArray(result?.data) ? result.data : [];
        const select = document.getElementById('vnpt_khu_vuc_id');
        select.innerHTML = '<option value="">-- Chọn khu vực --</option>' + items.map(item => `<option value="${item.id}">${item.ten_khu_vuc}</option>`).join('');
    } catch (error) {
        console.error('Load VNPT area failed', error);
    }
}

function toggleRoleFields() {
    const role = document.getElementById('vai_tro').value;
    const areaField = document.getElementById('vnptAreaField');
    areaField.style.display = role === 'vnpt_khu_vuc' ? 'block' : 'none';

    if (role !== 'vnpt_khu_vuc') {
        document.getElementById('vnpt_khu_vuc_id').value = '';
    }
}

async function saveUser(event) {
    event.preventDefault();
    const form = event.target;
    const role = document.getElementById('vai_tro').value;
    const payload = {
        username: document.getElementById('username').value,
        ho_ten: document.getElementById('ho_ten').value,
        email: document.getElementById('email').value,
        so_dien_thoai: document.getElementById('so_dien_thoai').value || null,
        vai_tro: role,
        vnpt_khu_vuc_id: role === 'vnpt_khu_vuc' ? (document.getElementById('vnpt_khu_vuc_id').value || null) : null,
        quyen_chuc_nang: Array.from(document.querySelectorAll('#permissionList input:checked')).map(item => item.value)
    };

    const userId = document.getElementById('userId').value;
    if (!userId) {
        payload.password = document.getElementById('password').value || 'Vnpt@2026';
    }

    const url = userId ? '/api/auth/users/' + userId : '/api/auth/users';
    const method = userId ? 'PUT' : 'POST';

    const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });
    const result = await res.json();

    if (result.success) {
        alert('Lưu tài khoản thành công');
        form.reset();
        const modal = bootstrap.Modal.getInstance(document.getElementById('userModal'));
        modal.hide();
        location.reload();
    } else {
        alert(result.message || 'Có lỗi xảy ra');
    }
}

function editUser(user) {
    document.getElementById('userModalTitle').textContent = 'Chỉnh sửa tài khoản';
    document.getElementById('userId').value = user.id;
    document.getElementById('username').value = user.username || '';
    document.getElementById('ho_ten').value = user.ho_ten || '';
    document.getElementById('email').value = user.email || '';
    document.getElementById('so_dien_thoai').value = user.so_dien_thoai || '';
    document.getElementById('vai_tro').value = user.vai_tro || 'staff';
    document.getElementById('vnpt_khu_vuc_id').value = user.vnpt_khu_vuc_id || '';
    document.getElementById('password').value = '';
    document.getElementById('passwordField').style.display = 'none';
    renderPermissions(Array.isArray(user.quyen_chuc_nang) ? user.quyen_chuc_nang : []);
    toggleRoleFields();
    const modal = new bootstrap.Modal(document.getElementById('userModal'));
    modal.show();
}

async function openCreateUserModal() {
    document.getElementById('userModalTitle').textContent = 'Tạo tài khoản';
    document.getElementById('userId').value = '';
    document.getElementById('userForm').reset();
    document.getElementById('passwordField').style.display = 'block';
    renderPermissions([]);
    toggleRoleFields();
    const modal = new bootstrap.Modal(document.getElementById('userModal'));
    modal.show();
}

async function lockUser(id) {
    const res = await fetch('/api/auth/users/' + id + '/lock', { method: 'PUT' });
    const result = await res.json();
    if (result.success) location.reload(); else alert(result.message || 'Loi');
}

async function unlockUser(id) {
    const res = await fetch('/api/auth/users/' + id + '/unlock', { method: 'PUT' });
    const result = await res.json();
    if (result.success) location.reload(); else alert(result.message || 'Loi');
}

async function resetPassword(id) {
    const res = await fetch('/api/auth/users/' + id + '/reset-password', { method: 'PUT' });
    const result = await res.json();
    if (result.success) alert(result.message); else alert(result.message || 'Loi');
}

window.addEventListener('DOMContentLoaded', async () => {
    renderPermissions([]);
    await loadVnptAreas();
    document.getElementById('vai_tro').addEventListener('change', toggleRoleFields);
    document.getElementById('userForm').addEventListener('submit', saveUser);
    document.querySelector('[data-bs-target="#userModal"]').addEventListener('click', openCreateUserModal);
    toggleRoleFields();
});
</script>
<%- include('../partials/footer') %>
